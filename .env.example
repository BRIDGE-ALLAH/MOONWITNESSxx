# MOONWITNESS local development defaults.
# Copy to .env; never commit real credentials.

NODE_ENV=development
ARSY_HOST=0.0.0.0
ARSY_PORT=3000

# ARSY operator-to-Headquarter private authentication.
ARSY_OPERATOR_ID=
ARSY_OPERATOR_TOKEN=
ARSY_API_BASE_URL=http://127.0.0.1:3001

# Headquarter operator login/session. Use unique high-entropy values.
HEADQUARTER_OPERATOR_PASSWORD=
HEADQUARTER_SESSION_SECRET=
HEADQUARTER_PUBLIC_ORIGIN=http://localhost:3000
# Keep 0 locally. Set to 1 only behind one trusted ingress that overwrites X-Forwarded-For.
HEADQUARTER_TRUSTED_PROXY_HOPS=0

# Database connection is required by ARSY.
DATABASE_URL=

# Optional: local AI-assisted commit text only.
# This is never required by install, lint, tests, CI, or Git hooks.
KILO_API_URL=https://api.kilo.ai/v1/chat/completions
KILO_API_KEY=
KILO_MODEL=kilo-free
KILO_MAX_TOKENS=500
KILO_TEMPERATURE=0.3

# Repository identity for explicitly invoked local GitHub scripts.
# GitHub Actions should use the scoped GITHUB_TOKEN, not a personal token.
GITHUB_OWNER=BRIDGE-ALLAH
GITHUB_REPO=MOONWITNESS
