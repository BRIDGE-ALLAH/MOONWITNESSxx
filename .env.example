# MOONWITNESS local development defaults.
# Copy to .env; never commit real credentials.

NODE_ENV=development
ARSY_HOST=0.0.0.0
ARSY_PORT=3001

# Database connection for local app execution. Docker Compose injects its service URL.
DATABASE_URL=
POSTGRES_DB=moonwitness
POSTGRES_USER=postgres
# Intentionally unset: Compose falls back to a local-only password and preflight warns.
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
HEADQUARTER_PORT=3000
NEXT_PUBLIC_ARSY_URL=http://localhost:3001

# Optional: local AI-assisted commit text only.
# This is never required by install, lint, tests, CI, or Git hooks.
KILO_API_URL=https://api.kilo.ai/v1/chat/completions
KILO_API_KEY=
KILO_MODEL=kilo-free
KILO_MAX_TOKENS=500
KILO_TEMPERATURE=0.3

# Repository identity for explicitly invoked local GitHub scripts.
# GitHub Actions should use the scoped GITHUB_TOKEN, not a personal token.
GITHUB_OWNER=BRIDGE-ALLAH
GITHUB_REPO=MOONWITNESS
