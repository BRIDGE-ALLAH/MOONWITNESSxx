# MOONWITNESS local development defaults.
# Copy to .env; never commit real credentials.

NODE_ENV=development
ARSY_HOST=0.0.0.0
ARSY_PORT=3000

# Database configuration is reserved for the upcoming data runtime.
# Leave empty until the corresponding adapter is implemented.
DATABASE_URL=

# Optional: local AI-assisted commit text only.
# This is never required by install, lint, tests, CI, or Git hooks.
KILO_API_URL=https://api.kilo.ai/v1/chat/completions
KILO_API_KEY=
KILO_MODEL=kilo-free
KILO_MAX_TOKENS=500
KILO_TEMPERATURE=0.3

# Repository identity for explicitly invoked local GitHub scripts.
# GitHub Actions should use the scoped GITHUB_TOKEN, not a personal token.
GITHUB_OWNER=BRIDGE-ALLAH
GITHUB_REPO=MOONWITNESS
