# MOONWITNESS local development defaults.
# Copy to .env and replace every credential placeholder before starting services.
# Never commit .env or place server secrets in NEXT_PUBLIC_ variables.

NODE_ENV=development

# ARSY host-run development. The ARSY dev script loads this repository-root .env.
HOST=127.0.0.1
PORT=3001

# Docker Compose host-port mappings; the ARSY container itself listens on PORT=3001.
ARSY_PORT=3001
HEADQUARTER_PORT=3000

# Compose constructs DATABASE_URL from POSTGRES_* inside the ARSY container.
# For host-run ARSY or migrations, set this to your reachable PostgreSQL connection.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/moonwitness
POSTGRES_DB=moonwitness
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Private ARSY operator API. Generate a unique high-entropy token.
ARSY_OPERATOR_ID=primary-owner
ARSY_OPERATOR_TOKEN=
ARSY_ASSET_STORAGE_DIR=/var/lib/arsy/assets

# Headquarter server-side BFF to ARSY. Use http://127.0.0.1:3001 when Headquarter runs on the host.
ARSY_API_BASE_URL=http://arsy:3001
NEXT_PUBLIC_ARSY_URL=http://localhost:3001

# Headquarter single-operator login/session. Generate unique values; never share these.
HEADQUARTER_OPERATOR_PASSWORD=
HEADQUARTER_SESSION_SECRET=
HEADQUARTER_PUBLIC_ORIGIN=http://localhost:3000

# Redis is included in the local Compose stack. It is not a production queue contract.
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# Optional local AI-assisted commit text only; not used by CI or application runtime.
KILO_API_URL=https://api.kilo.ai/v1/chat/completions
KILO_API_KEY=
KILO_MODEL=kilo-free
KILO_MAX_TOKENS=500
KILO_TEMPERATURE=0.3

# Repository identity for explicitly invoked local GitHub scripts.
GITHUB_OWNER=BRIDGE-ALLAH
GITHUB_REPO=MOONWITNESS
