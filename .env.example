# RIOTWORKS Kilo Gateway AI Configuration
# Copy this file to .env and fill in your values

# Kilo Gateway AI (Free Tier)
# Get your API key from: https://kilo.ai/dashboard
KILO_API_KEY=your_kilo_api_key_here

# Kilo Gateway AI Endpoint
KILO_API_URL=https://api.kilo.ai/v1/chat/completions

# Model (free tier)
KILO_MODEL=kilo-free

# Max tokens for AI responses
KILO_MAX_TOKENS=500

# Temperature (0.0 = deterministic, 1.0 = creative)
KILO_TEMPERATURE=0.3

# GitHub Token for issue creation
GH_TOKEN=your_github_token_here

# Repository info
GITHUB_OWNER=BRIDGE-ALLAH
GITHUB_REPO=RIOTWORKS