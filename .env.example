# MOONWITNESS local development defaults.
# Copy to .env; never commit real credentials.

NODE_ENV=development
ARSY_HOST=0.0.0.0
ARSY_PORT=3000

# ARSY PostgreSQL persistence. Required by the production ARSY service.
DATABASE_URL=

# Internal ARSY operator API. Keep the token server-side; never use NEXT_PUBLIC_ prefixes.
ARSY_OPERATOR_ID=primary-owner
ARSY_OPERATOR_TOKEN=
ARSY_API_BASE_URL=http://127.0.0.1:3001

# Headquarter operator login. Use a unique password (16+ characters) and at least 32 random bytes for the session secret.
# Set the exact browser-facing origin; mutations are rejected when the Origin header does not match.
HEADQUARTER_OPERATOR_PASSWORD=
HEADQUARTER_SESSION_SECRET=
HEADQUARTER_PUBLIC_ORIGIN=http://localhost:3000
# Production only: trusted ingress hop count and a separate HMAC secret for its signed client-IP assertion.
# The ingress must strip inbound x-mw-client-* and x-forwarded-for headers before signing.
HEADQUARTER_TRUSTED_PROXY_HOPS=0
HEADQUARTER_PROXY_IDENTITY_SECRET=

# Optional: local AI-assisted commit text only.
# This is never required by install, lint, tests, CI, or Git hooks.
KILO_API_URL=https://api.kilo.ai/v1/chat/completions
KILO_API_KEY=
KILO_MODEL=kilo-free
KILO_MAX_TOKENS=500
KILO_TEMPERATURE=0.3

# Repository identity for explicitly invoked local GitHub scripts.
# GitHub Actions should use the scoped GITHUB_TOKEN, not a personal token.
GITHUB_OWNER=BRIDGE-ALLAH
GITHUB_REPO=MOONWITNESS
