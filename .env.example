# Local non-Compose development environment for ARSY.
# Copy this file to the repository root as .env and set your own database password.
# ARSY loads this file when started with pnpm dev:arsy; process environment wins.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Required: ARSY opens PostgreSQL during startup and uses it for readiness.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/moonwitness

# Optional: used only by the explicitly invoked local AI commit-message helper.
# Never required by install, lint, tests, CI, or Git hooks.
KILO_API_URL=https://api.kilo.ai/v1/chat/completions
KILO_API_KEY=
KILO_MODEL=kilo-free
KILO_MAX_TOKENS=500
KILO_TEMPERATURE=0.3

# Repository identity for explicitly invoked local GitHub scripts.
GITHUB_OWNER=BRIDGE-ALLAH
GITHUB_REPO=MOONWITNESS
