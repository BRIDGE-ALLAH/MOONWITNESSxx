{
  "name": "@riotworks/orm-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema-planner": {
      "types": "./src/schema-planner.ts",
      "default": "./src/schema-planner.ts"
    },
    "./reconciler": {
      "types": "./src/reconciler.ts",
      "default": "./src/reconciler.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit --strict --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext src/index.ts src/runtime.ts src/schema-planner.ts src/reconciler.ts",
    "lint": "../lint/node_modules/.bin/eslint src test --config ../lint/eslint.config.mjs --max-warnings 0",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@riotworks/orm": "workspace:*",
    "@riotworks/orm-db-adaptor": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  }
}