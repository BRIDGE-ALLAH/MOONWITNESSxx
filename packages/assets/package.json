{
  "name": "@riotworks/assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canonical, typed visual asset library for RIOTWORKS and MOONWITNESS applications",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "validate": "node --experimental-strip-types scripts/validate-assets.mjs"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "react": "^19.0.0",
    "typescript": "^5.7.2"
  }
}