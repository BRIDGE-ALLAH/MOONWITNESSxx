{
  "name": "@riotworks/orm-db-adaptor-libsql",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": { ".": { "types": "./src/index.ts", "default": "./src/index.ts" } },
  "scripts": {
    "type-check": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions src/index.ts",
    "lint": "pnpm --filter @riotworks/lint exec eslint src test --config ../../packages/lint/.eslintrc.json --max-warnings 0",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "dependencies": { "@riotworks/orm-db-adaptor": "workspace:*", "@libsql/client": "^0.18.0" },
  "devDependencies": { "@types/node": "^22.10.2" }
}