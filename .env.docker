# LOCAL DEVELOPMENT ONLY — do not use these credentials in production.
# Docker Compose environment variables

# Node environment
NODE_ENV=development

# PostgreSQL configuration
POSTGRES_DB=moonwitness
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432

# ORACLE-only DB roles. Use random, URL-safe values outside local development.
ORACLE_APP_DB_PASSWORD=local-oracle-app-change-me
ORACLE_MIGRATOR_DB_PASSWORD=local-oracle-migrator-change-me

# Redis configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ORACLE internal service authentication (local development only).
# Replace this committed sample value before any shared/non-local deployment.
ORACLE_SERVICE_TOKEN=local-dev-only-oracle-service-token-change-me-2026
ORACLE_REQUEST_TIMEOUT_MS=5000
ORACLE_WORKER_COUNT=2
ORACLE_MAX_QUEUE_SIZE=100
ORACLE_MAX_RETAINED_JOBS=1000
ORACLE_JOB_LEASE_SECONDS=60
ORACLE_JOB_MAX_ATTEMPTS=3
ORACLE_JOB_RETENTION_SECONDS=604800

# ARSY backend
ARSY_PORT=3001
LOG_LEVEL=info

# Headquarter frontend
HEADQUARTER_PORT=3000
NEXT_PUBLIC_ARSY_URL=http://localhost:3001

# Operator authentication (leave empty only for an intentionally disabled local setup).
ARSY_OPERATOR_ID=
ARSY_OPERATOR_TOKEN=
HEADQUARTER_OPERATOR_PASSWORD=
HEADQUARTER_SESSION_SECRET=
HEADQUARTER_PUBLIC_ORIGIN=http://localhost:3000
ARSY_API_BASE_URL=http://arsy:3001

# Docker connector. The socket is not mounted by default.
DOCKER_CREDENTIALS_ENCRYPTION_KEY=
DOCKER_REMOTE_ALLOWED_HOSTS=
DOCKER_REMOTE_ALLOW_PRIVATE_NETWORKS=0
DOCKER_LOCAL_SOCKET_PATH=/var/run/docker.sock
HEADQUARTER_TRUSTED_PROXY_HOPS=0
