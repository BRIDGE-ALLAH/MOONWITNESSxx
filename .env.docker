# LOCAL DEVELOPMENT ONLY — do not use these credentials in production.
# Docker Compose environment variables

# Node environment
NODE_ENV=development

# PostgreSQL configuration
POSTGRES_DB=moonwitness
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432

# Redis configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ARSY backend
ARSY_PORT=3001
LOG_LEVEL=info

# Headquarter frontend
HEADQUARTER_PORT=3000
NEXT_PUBLIC_ARSY_URL=http://localhost:3001

# Operator authentication (leave empty only for an intentionally disabled local setup).
ARSY_OPERATOR_ID=
ARSY_OPERATOR_TOKEN=
HEADQUARTER_OPERATOR_PASSWORD=
HEADQUARTER_SESSION_SECRET=
HEADQUARTER_PUBLIC_ORIGIN=http://localhost:3000
ARSY_API_BASE_URL=http://arsy:3001

# Docker connector. The socket is not mounted by default.
DOCKER_CREDENTIALS_ENCRYPTION_KEY=
DOCKER_REMOTE_ALLOWED_HOSTS=
DOCKER_LOCAL_SOCKET_PATH=/var/run/docker.sock
HEADQUARTER_TRUSTED_PROXY_HOPS=0
