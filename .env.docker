# LOCAL DEVELOPMENT ONLY — do not use these credentials in production.
# Docker Compose environment variables

# Node environment
NODE_ENV=development

# PostgreSQL configuration
POSTGRES_DB=moonwitness
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432

# Redis configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ARSY backend
ARSY_PORT=3001
LOG_LEVEL=info

# Headquarter frontend
HEADQUARTER_PORT=3000
NEXT_PUBLIC_ARSY_URL=http://localhost:3001
