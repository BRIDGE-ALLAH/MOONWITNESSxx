# Local Docker Compose settings only. Never put credentials in this tracked template.
# Set POSTGRES_PASSWORD in the ignored .env file or your shell before starting Compose.

NODE_ENV=production

POSTGRES_DB=moonwitness
POSTGRES_USER=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://redis:6379

ARSY_PORT=3001
LOG_LEVEL=info

HEADQUARTER_PORT=3000
NEXT_PUBLIC_ARSY_URL=http://localhost:3001
