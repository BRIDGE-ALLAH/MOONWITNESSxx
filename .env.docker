# LOCAL DEVELOPMENT ONLY — these are public placeholder credentials.
# Compose binds published ports to 127.0.0.1. Never expose this stack to a network
# or reuse these values in staging/production.
NODE_ENV=development

# PostgreSQL (local-only placeholder; replace before sharing the machine).
POSTGRES_DB=moonwitness
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432

# Redis development service.
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ARSY backend and local operator identity.
ARSY_PORT=3001
LOG_LEVEL=info
ARSY_OPERATOR_ID=local-development-operator
ARSY_OPERATOR_TOKEN=local-dev-only-arsy-token-change-before-network-exposure
ARSY_ASSET_STORAGE_DIR=/var/lib/arsy/assets
ARSY_API_BASE_URL=http://arsy:3001

# Headquarter local operator login/session.
HEADQUARTER_PORT=3000
HEADQUARTER_OPERATOR_PASSWORD=local-dev-only-change-me
HEADQUARTER_SESSION_SECRET=local-dev-only-session-secret-replace-before-network-exposure-32bytes
HEADQUARTER_PUBLIC_ORIGIN=http://localhost:3000
# Set to 1 only when a trusted ingress overwrites X-Forwarded-For and direct access is blocked.
HEADQUARTER_TRUSTED_PROXY_HOPS=0
NEXT_PUBLIC_ARSY_URL=http://localhost:3001
