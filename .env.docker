# LOCAL DEVELOPMENT ONLY — do not use these credentials in production.
# Docker Compose environment variables

# Node environment
NODE_ENV=development

# PostgreSQL configuration
POSTGRES_DB=moonwitness
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432

# Redis configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ARSY backend
ARSY_PORT=3001
LOG_LEVEL=info
ARSY_OPERATOR_ID=primary-owner
ARSY_OPERATOR_TOKEN=local-dev-only-change-this-token-before-sharing

# Headquarter frontend
HEADQUARTER_PORT=3000
NEXT_PUBLIC_ARSY_URL=http://localhost:3001
ARSY_API_BASE_URL=http://arsy:3001
HEADQUARTER_OPERATOR_PASSWORD=local-dev-only-operator-password-change-me
HEADQUARTER_SESSION_SECRET=local-dev-only-session-signing-secret-change-this-value
HEADQUARTER_PUBLIC_ORIGIN=http://localhost:3000
HEADQUARTER_TRUSTED_PROXY_HOPS=0
HEADQUARTER_PROXY_IDENTITY_SECRET=
