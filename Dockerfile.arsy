# Production-capable ARSY runtime image. Compose overrides the command for local hot reload.
FROM node:24-alpine

WORKDIR /app
RUN npm install -g pnpm@12.16.1

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages ./packages
COPY apps ./apps

RUN pnpm install --frozen-lockfile --ignore-scripts --prod=false
RUN pnpm --filter @riotworks/arsy run build

ENV NODE_ENV=production
ENV HOST=0.0.0.0
WORKDIR /app/apps/arsy
EXPOSE 3001
CMD ["pnpm", "start"]
