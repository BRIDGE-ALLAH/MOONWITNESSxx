# syntax=docker/dockerfile:1.7

FROM node:24.22.2-alpine3.23 AS build
WORKDIR /workspace
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

RUN npm install --global pnpm@12.16.1

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json ./
COPY packages ./packages
COPY apps/arsy ./apps/arsy
COPY scripts/prepare-arsy-runtime-packages.mjs ./scripts/prepare-arsy-runtime-packages.mjs

RUN pnpm install --filter @riotworks/arsy... --frozen-lockfile --ignore-scripts
RUN pnpm --filter @riotworks/arsy build
RUN node scripts/prepare-arsy-runtime-packages.mjs
RUN pnpm --filter @riotworks/arsy --prod deploy /out/arsy

FROM node:24.22.2-alpine3.23 AS runtime
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3001
WORKDIR /workspace/apps/arsy

# ARSY has one existing type-only source import that resolves through the original
# monorepo-relative packages/ path. Preserve that minimal source layout while the
# deployed package supplies the pruned production node_modules tree.
COPY --from=build --chown=node:node /workspace/packages/ /workspace/packages/
COPY --from=build --chown=node:node /out/arsy/ ./

USER node
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/health/ready').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "--experimental-transform-types", "src/index.ts"]
