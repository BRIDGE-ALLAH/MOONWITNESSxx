{
  "name": "automation-plugin",
  "description": "Codex plugin for running automated repository maintenance tasks",
  "version": "1.0.0",
  "author": "RIOTWORKS",
  "commands": [
    {
      "name": "audit-repo",
      "description": "Run full repository audit",
      "command": "pnpm run audit:repo",
      "category": "maintenance"
    },
    {
      "name": "validate-commit",
      "description": "Validate commit message format",
      "command": "pnpm run check:commit --",
      "category": "validation"
    },
    {
      "name": "check-lockfile",
      "description": "Check lockfile for drift",
      "command": "pnpm run lockfile:check",
      "category": "maintenance"
    },
    {
      "name": "check-staged",
      "description": "Validate staged changes",
      "command": "git diff --staged",
      "category": "validation"
    }
  ],
  "ui": {
    "icon": "🔧",
    "color": "#3b82f6",
    "label": "Automation"
  }
}
