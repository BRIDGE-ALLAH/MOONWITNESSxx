# Copy to .env.docker (ignored by Git) and set a strong local-only password.
NODE_ENV=development
POSTGRES_DB=moonwitness
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_URL=redis://redis:6379
ARSY_PORT=3001
ARSY_BIND_ADDRESS=127.0.0.1
LOG_LEVEL=info
HEADQUARTER_PORT=3000
HEADQUARTER_BIND_ADDRESS=127.0.0.1
NEXT_PUBLIC_ARSY_URL=http://localhost:3001
