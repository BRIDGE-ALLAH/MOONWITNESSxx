{
  "name": "moonwitness",
  "version": "1.0.11",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @riotworks/headquarter run dev",
    "dev:headquarter": "pnpm --filter @riotworks/headquarter run dev",
    "dev:arsy": "pnpm --filter @riotworks/arsy run dev",
    "dev:all": "pnpm --parallel --filter @riotworks/headquarter --filter @riotworks/arsy run dev",
    "lint": "turbo run lint",
    "lint:all": "pnpm run lint",
    "typecheck": "turbo run type-check",
    "typecheck:all": "pnpm run typecheck",
    "test": "node --test",
    "clean": "turbo run clean",
    "check:repo": "node scripts/repo-audit.mjs",
    "audit:repo": "node scripts/repo-audit.mjs --write-report",
    "format:check": "pnpm exec prettier --check package.json pnpm-workspace.yaml turbo.json",
    "validate:repo": "pnpm run check:repo && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "validate": "pnpm run validate:repo && pnpm run build",
    "lockfile:check": "node scripts/check-lockfile.mjs",
    "lockfile:refresh": "node scripts/check-lockfile.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.16.1"
}
