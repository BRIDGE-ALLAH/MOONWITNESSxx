{
  "name": "moonwitness",
  "version": "1.0.11",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @riotworks/headquarter run dev",
    "dev:headquarter": "pnpm --filter @riotworks/headquarter run dev",
    "dev:arsy": "pnpm --filter @riotworks/arsy run dev",
    "dev:all": "turbo run dev --parallel",
    "lint:all": "pnpm run lint",
    "lint": "pnpm run format:check",
    "format": "node scripts/format-changed.mjs --write",
    "format:check": "node scripts/format-changed.mjs --check",
    "typecheck:all": "pnpm run type-check",
    "typecheck": "pnpm run type-check",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "check:repo": "pnpm exec node scripts/repo-audit.mjs && pnpm run lockfile:check",
    "audit:repo": "pnpm exec node scripts/repo-audit.mjs --write-report",
    "test": "node --test",
    "validate:repo": "pnpm run check:repo && pnpm run format:check && pnpm test",
    "validate": "pnpm run validate:repo && pnpm run type-check && pnpm run build",
    "lockfile:check": "pnpm exec node scripts/check-lockfile.mjs",
    "lockfile:refresh": "pnpm exec node scripts/check-lockfile.mjs --lockfile-only"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
