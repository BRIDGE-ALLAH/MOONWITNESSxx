{
  "name": "moonwitness",
  "version": "1.0.11",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @riotworks/headquarter run dev",
    "dev:headquarter": "pnpm --filter @riotworks/headquarter run dev",
    "dev:arsy": "pnpm --filter @riotworks/arsy run dev",
    "dev:all": "turbo run dev --parallel",
    "lint:all": "turbo run lint",
    "lint": "turbo run lint",
    "typecheck:all": "pnpm run type-check",
    "typecheck": "pnpm run type-check",
    "clean": "turbo run clean",
    "check:repo": "pnpm exec node scripts/repo-audit.mjs && pnpm run lockfile:check && pnpm run governance:check",
    "audit:repo": "pnpm exec node scripts/repo-audit.mjs --write-report",
    "format:check": "node scripts/format-changed.mjs --check",
    "validate:repo": "pnpm run check:repo && pnpm run format:check && pnpm test",
    "validate": "pnpm run validate:repo && pnpm run type-check && pnpm run build",
    "lockfile:check": "pnpm exec node scripts/check-lockfile.mjs",
    "lockfile:refresh": "pnpm exec node scripts/check-lockfile.mjs --lockfile-only",
    "type-check": "turbo run type-check",
    "setup:install": "node scripts/moonwitness.mjs install",
    "setup:doctor": "node scripts/moonwitness.mjs doctor",
    "setup:repair": "node scripts/moonwitness.mjs repair",
    "setup:update": "node scripts/moonwitness.mjs update",
    "setup:verify": "node scripts/moonwitness.mjs verify",
    "setup:uninstall": "node scripts/moonwitness.mjs uninstall",
    "runtime:doctor": "node scripts/runtime.mjs doctor",
    "runtime:preflight": "node scripts/runtime.mjs preflight",
    "runtime:health": "node scripts/runtime.mjs health",
    "runtime:passport": "node scripts/runtime.mjs passport",
    "test:installer-runtime": "node --test scripts/moonwitness.test.mjs scripts/runtime.test.mjs",
    "format": "node scripts/format-changed.mjs --write",
    "test": "node --test",
    "check:commit": "node scripts/check-commit-message.mjs",
    "check:staged": "node scripts/check-staged.mjs",
    "governance:check": "node scripts/governance.mjs check",
    "governance:doctor": "node scripts/governance.mjs doctor",
    "governance:report": "node scripts/governance.mjs report"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
