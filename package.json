{
  "name": "moonwitness",
  "version": "1.0.9",
  "private": true,
  "description": "MOONWITNESS monorepo for the creative commerce ecosystem",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:headquarter": "pnpm --filter @riotworks/headquarter dev",
    "dev:arsy": "pnpm --filter @riotworks/arsy dev",
    "lint": "pnpm run check:repo && pnpm run format:check",
    "type-check": "turbo run type-check",
    "test": "node --test",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check:repo": "node scripts/repo-audit.mjs",
    "audit:repo": "node scripts/repo-audit.mjs --write-report",
    "check:staged": "node scripts/check-staged.mjs",
    "lockfile:check": "node scripts/check-lockfile.mjs",
    "lockfile:refresh": "pnpm install --lockfile-only --ignore-scripts",
    "validate:repo": "pnpm run check:repo && pnpm run format:check && pnpm run test",
    "validate": "pnpm run validate:repo && pnpm run type-check && pnpm run build",
    "commit:assist": "node scripts/ai/generate-commit.js",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.16.1"
}
