{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "MOONWITNESS COCKPIT",
  "version": "0.1.0",
  "identifier": "id.biz.moonwitness.cockpit",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3002"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MOONWITNESS COCKPIT — Operations Flight Deck",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
