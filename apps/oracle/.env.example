# Local development is loopback-only and may omit the service token.
ORACLE_ENV=development
ORACLE_HOST=127.0.0.1
ORACLE_PORT=8010

# Set a long random token whenever ORACLE_HOST is not loopback.
# ORACLE_DATABASE_URL=postgresql://oracle_app:<app-password>@127.0.0.1:5432/moonwitness
# ORACLE_SERVICE_TOKEN=

ORACLE_WORKER_COUNT=1
ORACLE_MAX_QUEUE_SIZE=100
ORACLE_MAX_RETAINED_JOBS=1000
ORACLE_MAX_NUMERIC_VALUES=10000
ORACLE_MAX_TEXT_CHARS=100000
ORACLE_SHUTDOWN_GRACE_SECONDS=5
ORACLE_JOB_LEASE_SECONDS=60
ORACLE_JOB_MAX_ATTEMPTS=3
ORACLE_JOB_RETENTION_SECONDS=604800
ORACLE_DB_MIN_POOL_SIZE=1
ORACLE_DB_MAX_POOL_SIZE=8
