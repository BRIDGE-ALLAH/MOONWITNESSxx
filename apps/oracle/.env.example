# Local development is loopback-only and may omit the service token.
ORACLE_ENV=development
ORACLE_HOST=127.0.0.1
ORACLE_PORT=8010

# Set a long random token whenever ORACLE_HOST is not loopback.
# ORACLE_SERVICE_TOKEN=

ORACLE_WORKER_COUNT=1
ORACLE_MAX_QUEUE_SIZE=100
ORACLE_MAX_RETAINED_JOBS=1000
ORACLE_MAX_NUMERIC_VALUES=10000
ORACLE_MAX_TEXT_CHARS=100000
ORACLE_SHUTDOWN_GRACE_SECONDS=5

# Optional durable queue for shared local/test environments. Apply
# migrations/001_oracle_jobs.sql explicitly before enabling this value.
# Use the dedicated non-owner app role; provision it and apply migrations explicitly.
# ORACLE_DATABASE_URL=postgresql://oracle_app:change-me@127.0.0.1:5432/moonwitness
ORACLE_JOB_LEASE_SECONDS=120
ORACLE_MAX_JOB_ATTEMPTS=3
ORACLE_JOB_RETENTION_SECONDS=86400
