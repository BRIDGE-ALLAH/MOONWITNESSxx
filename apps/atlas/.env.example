# ATLAS application
ATLAS_PORT=5150
ATLAS_PUBLIC_URL=http://localhost:5150
DB_MAX_CONNECTIONS=10

# Use URL-safe passwords because they are embedded in connection URLs.
ATLAS_DB_PASSWORD=replace-with-a-long-url-safe-password
ATLAS_DB_ROOT_PASSWORD=replace-with-a-long-root-password
ATLAS_REDIS_PASSWORD=replace-with-a-long-redis-password
RADIUS_DB_PASSWORD=replace-with-a-32-character-alphanumeric-secret

# Observability backends are exposed on loopback for local administration.
VICTORIA_METRICS_PORT=8428
VICTORIA_LOGS_PORT=9428

# FreeRADIUS is loopback-bound by default. Configure clients.conf and firewall
# rules before binding to an interface reachable by NAS devices.
RADIUS_BIND_ADDRESS=127.0.0.1
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
