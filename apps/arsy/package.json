{
  "name": "@riotworks/arsy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "RIOTWORKS ARSY application runtime",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "pnpm run type-check",
    "start": "node --experimental-strip-types src/index.ts",
    "lint": "pnpm exec prettier --check src/app.ts src/config.ts src/db.ts src/index.ts tests/runtime.test.mjs",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@riotworks/arsy-core": "workspace:*",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^1.1.0",
    "zod": "^3.23.8",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "fastify-cli": "^8.0.3",
    "typescript": "^5.7.2"
  }
}
