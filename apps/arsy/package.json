{
  "name": "@riotworks/arsy",
  "version": "0.0.0",
  "private": true,
  "description": "RIOTWORKS ARSY HTTP application runtime",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "pnpm run type-check",
    "start": "node --experimental-strip-types src/index.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=false pnpm --filter @riotworks/lint exec eslint --config .eslintrc.json ../../apps/arsy/src --ext .ts --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@riotworks/arsy-core": "workspace:*",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^1.1.0",
    "zod": "^3.23.8",
    "pg": "^8.0.0",
    "@fastify/rate-limit": "11.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "fastify-cli": "^8.0.3",
    "typescript": "^5.7.2"
  },
  "type": "module"
}
