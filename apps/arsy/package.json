{
  "name": "@riotworks/arsy",
  "version": "0.0.0",
  "private": true,
  "description": "ARSY HTTP application with rate-limited database health checks",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch --experimental-transform-types src/index.ts",
    "build": "pnpm run type-check",
    "start": "node --experimental-transform-types src/index.ts",
    "lint": "eslint src --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "test:integration": "node --experimental-transform-types --test tests/*.integration.mjs",
    "migrate:up": "node --experimental-transform-types src/migrations/runner.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.2",
    "@riotworks/arsy-core": "workspace:*",
    "@riotworks/contract": "workspace:*",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^1.1.0",
    "zod": "^4.6.7",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@riotworks/lint": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "fastify-cli": "^8.0.3",
    "typescript": "^5.7.2"
  },
  "type": "module"
}
