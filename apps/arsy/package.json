  },
  "dependencies": {
    "@riotworks/arsy-core": "workspace:*",
    "@riotworks/ui": "workspace:*",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^1.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}