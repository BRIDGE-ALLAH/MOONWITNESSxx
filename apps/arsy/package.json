{
  "name": "@riotworks/arsy",
  "version": "0.0.0",
  "private": true,
  "description": "RIOTWORKS ARSY — Command Center (wraps @riotworks/arsy-core)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "pnpm --filter @riotworks/arsy-core run dev",
    "build": "pnpm --filter @riotworks/arsy-core run build",
    "start": "pnpm --filter @riotworks/arsy-core run start",
