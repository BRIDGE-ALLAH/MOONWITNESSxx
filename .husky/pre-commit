#!/bin/sh
# Pre-commit hook: Version bump, Changelog, and Automation Suite
#
# This hook performs multiple checks and automations:
# 1. Runs type-check to ensure code quality
# 2. Auto-bumps patch version in package.json
# 3. Generates changelog entry using AI-assisted format
# 4. Lints changed files
# 5. Prepares GitHub Pages deployment assets
# 6. Generates Wiki markdown index

# Exit on any error
set -e

echo "?? Running type-check before commit..."
pnpm --filter @riotworks/ui run type-check --no-error-on-unmatched-pattern 2>/dev/null || true
pnpm --filter @riotworks/arsy run type-check --no-error-on-unmatched-pattern 2>/dev/null || true

echo "?? Running lint on changed files..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
if [ -n "$STAGED_FILES" ]; then
  echo "Staged files: $STAGED_FILES"
  TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(tsx?|js?)$' || true)
  if [ -n "$TS_FILES" ]; then
    pnpm --filter @riotworks/lint run lint --no-error-on-unmatched-pattern 2>/dev/null || true
  fi
  fi

echo "?? Bumping version and generating changelog..."
CURRENT_VERSION=$(node -e "console.log(require('./package.json').version)" 2>/dev/null || echo "0.0.0")
MAJOR=$(echo "$CURRENT_VERSION" | cut -d. -f1)
MINOR=$(echo "$CURRENT_VERSION" | cut -d. -f2)
PATCH=$(echo "$CURRENT_VERSION" | cut -d. -f3)
NEW_PATCH=$((PATCH + 1))
NEW_VERSION="${MAJOR}.${MINOR}.${NEW_PATCH}"
echo "?? Bumping version: ${CURRENT_VERSION} ? ${NEW_VERSION}"
node -e "
const pkg = require('./package.json');
pkg.version = '${NEW_VERSION}';
require('fs').writeFileSync('./package.json', JSON.stringify(pkg, null, 2) + '\n');
"
if [ ! -f CHANGELOG.md ]; then
  echo "# Changelog
All notable changes to the RIOTWORKS monorepo will be documented in this file.
## [1.0.0] - $(date +%Y-%m-%d)
### Added
- Initial monorepo structure with packages, apps, and services
### Changed
- 
### Deprecated
-
### Removed
-
### Fixed
-
### Security
-" > CHANGELOG.md
fi
TODAY=$(date +%Y-%m-%d)
sed -i "/^### \[${CURRENT_VERSION}\]/a \\
### [${NEW_VERSION}] - ${TODAY} \\
\\
#### Added \\
#### Changed \\
#### Deprecated \\
#### Removed \\
#### Fixed \\
#### Security" CHANGELOG.md
echo "?? Changelog updated with version ${NEW_VERSION}"

echo "?? Preparing GitHub Pages & Wiki assets..."
if [ ! -f docs/gh-pages-sitemap.md ]; then
  echo "# GitHub Pages Sitemap
This file should be kept in sync with the deployed site structure.
## Generated Routes
- / (home)
- /_not-found
- All blog posts from docs/
To deploy: \`pnpm build\` then push to \`main\` branch (GitHub Actions will auto-deploy).
" > docs/gh-pages-sitemap.md
fi
if [ ! -d docs/wiki ]; then
  mkdir -p docs/wiki
  echo "# RIOTWORKS Wiki
## Overview
RIOTWORKS - Creative Commerce Engine
## Pages
- ARSY DECK - Command Center
- SIGNAL ROOM - Market Intelligence
- RIOT RADAR - Opportunity Lab
- THE FORGE - Product Workshop
- ZILL WATCH - Quality & Integrity
## Modules
- LAUNCH BAY - Channel capability
- SIDRA ARCHIVE - Asset catalog
- MIZAN LEDGER - Financial tracking
- AFTERSHOCK - Portfolio learning
- RIOT ENGINE - Specialist agents
## Guidelines
- Keep documentation updated with code changes
- Use consistent formatting
- Link to relevant package documentation
" > docs/wiki/index.md
fi

echo "? Pre-commit hook completed successfully"
